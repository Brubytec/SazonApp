      "name": "01 Mesas y pedidos (RF-006, RF-007, RF-008)",
      "description": "",
      "item": [
        {
          "name": "Listar mesas con token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código esperado: 200\", function () { pm.expect([200]).to.include(pm.response.code); });",
                  "// Elegir automáticamente una mesa disponible para el caso 'Abrir pedido'",
                  "let arr = [];",
                  "try { const j = pm.response.json(); arr = Array.isArray(j) ? j : (j.data || j.mesas || []); } catch (e) {}",
                  "const libre = arr.find(function (m) { return String(m.estado || '').toLowerCase().indexOf('disp') === 0; });",
                  "pm.test('Existe al menos una mesa disponible', function () { pm.expect(libre, 'no hay mesas disponibles en la base local').to.not.be.undefined; });",
                  "if (libre) { pm.environment.set('id_mesa_libre', String(libre.id_mesa !== undefined ? libre.id_mesa : libre.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mesas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mesas"
              ]
            },
            "description": "Además de verificar el 200, guarda en id_mesa_libre la primera mesa con estado disponible."
          }
        },
        {
          "name": "Listar mesas sin token",
