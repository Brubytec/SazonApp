          "name": "Health (público)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cada ejecución parte limpia: se descartan los ids guardados antes",
                  "['pedido_id', 'producto_id', 'producto_mesero_id'].forEach(function (v) { pm.environment.set(v, ''); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código esperado: 200\", function () { pm.expect([200]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
