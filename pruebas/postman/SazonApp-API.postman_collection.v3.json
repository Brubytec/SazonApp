                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código esperado: 201\", function () { pm.expect([201]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  try {",
                  "    const j = pm.response.json();",
                  "    const d = j.data || j;",
                  "    const id = d.id || d.id_pedido || d.id_producto || d.insertId || (d.pedido && (d.pedido.id || d.pedido.id_pedido)) || (d.producto && (d.producto.id || d.producto.id_producto));",
                  "    if (id) { pm.environment.set(\"pedido_id\", String(id)); }",
                  "  } catch (e) {}",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
